# Copy to .env.local (or .env) and adjust if needed. Both are already
# git-ignored (see .gitignore's "*.local" and root .gitignore's ".env").

# Base URL the API client prefixes every request with. Leave unset (or
# empty) — the supported local setup. Requests then go to a relative
# /api/v1/... path, which vite.config.ts's dev-server proxy forwards to
# the FastAPI backend on http://127.0.0.1:8000, entirely on the Vite dev
# server's own origin from the browser's point of view.
#
# Setting this to any other origin bypasses that proxy: the browser then
# makes a direct cross-origin request, which needs this exact origin
# listed in the backend's own BACKEND_CORS_ORIGINS (see
# backend/.env.example) or the browser will block the response. CORS is
# off by default on the backend, and this project still has no non-local
# deployment -- don't set this expecting a hosted origin to work without
# also configuring the backend allowlist to match.
# VITE_API_BASE_URL=http://localhost:8000
