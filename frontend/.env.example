# Copy to .env.local (or .env) and adjust if needed. Both are already
# git-ignored (see .gitignore's "*.local" and root .gitignore's ".env").

# Base URL the API client prefixes every request with. Leave unset (or
# empty) for local development — requests then go to a relative
# /api/v1/... path, which vite.config.ts's dev-server proxy forwards to
# the FastAPI backend. Set this only when the frontend and backend are on
# genuinely different origins (e.g. a non-local deployment).
# VITE_API_BASE_URL=http://localhost:8000
