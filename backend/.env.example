# Copy to backend/.env and adjust if needed.
# Nothing here is required for the supported local setup (Vite's dev-server
# proxy, see frontend/.env.example) -- the app has no database yet, and CORS
# is off by default.
DATABASE_URL=postgresql://bowling:bowling@localhost:5432/bowling_sim

# Origins allowed to make cross-origin requests to this API, as a JSON
# array. Only needed if a frontend is hosted on its own origin instead of
# going through Vite's same-origin dev proxy (see frontend/.env.example's
# VITE_API_BASE_URL) -- leave unset for local development. Empty/unset
# means no CORSMiddleware is installed at all: the app sends no CORS allow
# headers to anyone, same as before this setting existed.
# BACKEND_CORS_ORIGINS=["https://frontend.example"]
